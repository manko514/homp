default_platform(:android)

platform :android do

  desc "Build signed release APK"
  lane :build do
    Dir.chdir("..") do
      sh("flutter build apk --release --dart-define=API_URL=#{ENV['API_URL'] || 'http://10.0.0.216:3001'}")
    end
    UI.success("✅ APK built: build/app/outputs/flutter-apk/app-release.apk")
  end

  desc "Build AAB for Play Store"
  lane :bundle do
    Dir.chdir("..") do
      sh("flutter build appbundle --release --dart-define=API_URL=#{ENV['API_URL'] || 'https://api.yourdomain.com'}")
    end
    UI.success("✅ AAB built: build/app/outputs/bundle/release/app-release.aab")
  end

  desc "Deploy to Play Store internal track"
  lane :deploy_internal do
    bundle
    upload_to_play_store(
      track: "internal",
      aab: "build/app/outputs/bundle/release/app-release.aab",
      package_name: "com.homp.staff",
      json_key: ENV['PLAY_STORE_JSON_KEY'],
    )
    UI.success("🚀 Uploaded to Play Store internal track!")
  end

  desc "Promote internal → production"
  lane :promote_to_production do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      package_name: "com.homp.staff",
      json_key: ENV['PLAY_STORE_JSON_KEY'],
    )
  end

end
