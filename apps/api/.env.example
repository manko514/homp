# Copy to .env and fill in values before running

DATABASE_URL="postgresql://postgres:password@localhost:5432/homp_dev"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-to-a-long-random-string-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="another-long-random-string-different-from-above"
